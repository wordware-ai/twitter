# Do not expose your Neon credentials to the browser
DATABASE_URL=

# --- AI (Vercel AI Gateway) ---
# Create a key at https://vercel.com/dashboard → AI Gateway.
# On Vercel deployments OIDC auth is automatic and this can be omitted.
AI_GATEWAY_API_KEY=
# Any Gateway model string (https://vercel.com/ai-gateway/models). Defaults to zai/glm-5.2.
AI_MODEL=

# --- Twitter/X data ---
# Official X API v2 bearer token (pay-per-use). Primary data source.
# https://developer.x.com
X_API_BEARER_TOKEN=
# SocialData API key — fallback scraper (https://socialdata.tools)
SOCIALDATA_API_KEY=

# Base URL for the application (e.g., http://localhost:3000 for local development).
# Share links and OG URLs derive from this.
NEXT_PUBLIC_BASE_URL=

# PostHog analytics configuration
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Stripe configuration (paywall plumbing — disabled by default via src/lib/config.tsx)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRODUCT_ID=
